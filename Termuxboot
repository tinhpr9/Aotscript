# 1. Tạo thư mục boot nếu chưa có
mkdir -p ~/.termux/boot

#!/data/data/com.termux/files/usr/bin/bash
export PATH=/data/data/com.termux/files/usr/bin:$PATH

termux-wake-lock
sleep 15

# NGUY TRANG TOKEN
PART1="ghp_"
PART2="Điền_Đuôi_Token_Của_Bác_Vào_Đây"
MY_TOKEN="${PART1}${PART2}"

curl -sL "https://${MY_TOKEN}@raw.githubusercontent.com/tinhpr9/Aotscript/refs/heads/main/agent" -o /sdcard/Download/Agent_Core.py
python /sdcard/Download/Agent_Core.py > /sdcard/Download/Agent_Log.txt 2>&1 &
EOF

# 3. Cấp quyền thực thi cho file vừa tạo
chmod +x ~/.termux/boot/01-agent.sh

# 4. Kiểm tra lại xem file đã nằm đúng chỗ chưa
ls -l ~/.termux/boot/
