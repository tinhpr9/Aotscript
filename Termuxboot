mkdir -p ~/.termux/boot

cat << 'EOF' > ~/.termux/boot/01-agent.sh
#!/data/data/com.termux/files/usr/bin/bash
export PATH=/data/data/com.termux/files/usr/bin:$PATH

termux-wake-lock
sleep 15

curl -sL "https://raw.githubusercontent.com/tinhpr9/Aotscript/refs/heads/main/agent?t=$(date +%s)" -o /sdcard/Download/Agent_Core.py
python /sdcard/Download/Agent_Core.py > /sdcard/Download/Agent_Log.txt 2>&1 &
EOF

chmod +x ~/.termux/boot/01-agent.sh
ls -l ~/.termux/boot/
