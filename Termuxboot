#!/data/data/com.termux/files/usr/bin/bash

export PATH="/data/data/com.termux/files/usr/bin:$PATH"

PYTHON="/data/data/com.termux/files/usr/bin/python"
CURL="/data/data/com.termux/files/usr/bin/curl"
AGENT="/sdcard/Download/Agent_Core.py"
TEMP="/sdcard/Download/Agent_Core.py.tmp"
LOG="/sdcard/Download/Agent_Log.txt"
ID_FILE="/sdcard/Download/Shouko/device_id.txt"
GROUP_FILE="/sdcard/Download/Shouko/device_group.txt"
CONFIG_FILE="/sdcard/Download/Shouko/agent_config.json"
STATE_FILE="${AOTSCRIPT_STATE_FILE:-$HOME/.local/state/aotscript/mprovision.json}"
MPROVISION="/data/data/com.termux/files/usr/bin/mprovision"
LOCK_DIR="$HOME/.cache/aotscript-agent-start.lock"
AOT_CONFIG_FILE="/sdcard/Download/Shouko/aot_group_config.json"
AOT_RUNTIME_DIR="$HOME/.aot-group-control"
AOT_LOG="/sdcard/Download/AOT_Group_Control.log"
AOT_REF="${AOTSCRIPT_AOT_REF:-main}"

mkdir -p "/sdcard/Download/Shouko" "$HOME/.cache"

list_agent_pids() {
  "$PYTHON" - <<'__AOTSCRIPT_AGENT_PID_SCAN_V2_PY__'
import os
import pathlib

pids = []

for entry in os.listdir("/proc"):
    if not entry.isdigit():
        continue

    try:
        arguments = [
            part.decode(
                "utf-8",
                errors="replace",
            )
            for part in pathlib.Path(
                f"/proc/{entry}/cmdline"
            ).read_bytes().split(b"\0")
            if part
        ]
    except Exception:
        continue

    if any(
        argument.endswith(
            "/Download/Agent_Core.py"
        )
        for argument in arguments
    ):
        pids.append(int(entry))

for pid in sorted(set(pids)):
    print(pid)
__AOTSCRIPT_AGENT_PID_SCAN_V2_PY__
}

resolve_provision_ref() {
  "$PYTHON" - "$STATE_FILE" <<'PY_AOTSCRIPT_BOOT_REF'
import json
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])

try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    print("main")
    raise SystemExit(0)

phase = str(data.get("phase", "")).strip()
ref = str(data.get("provision_ref", "")).strip()

if phase and phase != "complete" and re.fullmatch(r"[0-9a-f]{40}", ref):
    print(ref)
else:
    print("main")
PY_AOTSCRIPT_BOOT_REF
}

provision_incomplete() {
  "$PYTHON" - "$STATE_FILE" <<'PY_AOTSCRIPT_BOOT_INCOMPLETE'
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])

try:
    data = json.loads(path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    raise SystemExit(1)

phase = str(data.get("phase", "")).strip()
raise SystemExit(0 if phase and phase != "complete" else 1)
PY_AOTSCRIPT_BOOT_INCOMPLETE
}

start_aot_group_control() {
  local stage
  local name

  [ -s "$AOT_CONFIG_FILE" ] || return 0

  if ! "$PYTHON" - "$AOT_CONFIG_FILE" <<'PY_AOT_BOOT_CONFIG'
import json
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])

try:
    data = json.loads(path.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(1)

if not isinstance(data, dict) or data.get("enabled") is not True:
    raise SystemExit(1)

role = str(data.get("role") or "").strip().lower()
session = str(data.get("session_id") or "").strip()
reference = str(data.get("reference_device_id") or "").strip().lower()
package = data.get("open_package")

if role not in {"reference", "follower"}:
    raise SystemExit(1)

if not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", session):
    raise SystemExit(1)

if role == "follower" and not re.fullmatch(r"m[1-9]\d{0,5}", reference):
    raise SystemExit(1)

if package not in (None, ""):
    if not isinstance(package, str) or not re.fullmatch(
        r"[A-Za-z0-9._]{1,160}",
        package,
    ):
        raise SystemExit(1)
PY_AOT_BOOT_CONFIG
  then
    echo "[SKIP] AOT Group Control config chưa bật hoặc không hợp lệ."
    return 0
  fi

  mkdir -p "$AOT_RUNTIME_DIR" "$HOME/.cache"
  stage="$(mktemp -d "$HOME/.cache/aot-runtime.XXXXXX")" || {
    echo "[LỖI] Không tạo được thư mục tạm AOT runtime."
    return 1
  }

  for name in controller.py relay.py runtime.py e2e.py; do
    if ! "$CURL" -fsSL \
      --retry 3 \
      --connect-timeout 15 \
      "https://raw.githubusercontent.com/tinhpr9/Aotscript/$AOT_REF/aot-group-control/$name?t=$(date +%s)" \
      -o "$stage/$name"
    then
      echo "[LỖI] Không tải được AOT runtime: $name"
      rm -rf "$stage"
      return 1
    fi
  done

  if ! "$PYTHON" - "$stage" <<'PY_AOT_BOOT_COMPILE'
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
for name in ("controller.py", "relay.py", "runtime.py", "e2e.py"):
    path = root / name
    source = path.read_text(encoding="utf-8")
    compile(source, str(path), "exec")
PY_AOT_BOOT_COMPILE
  then
    echo "[LỖI] AOT runtime tải về sai cú pháp."
    rm -rf "$stage"
    return 1
  fi

  if ! "$PYTHON" - "$stage" "$AOT_RUNTIME_DIR" <<'PY_AOT_BOOT_REPLACE'
import os
import pathlib
import sys

src = pathlib.Path(sys.argv[1])
dst = pathlib.Path(sys.argv[2])

for name in ("controller.py", "relay.py", "runtime.py", "e2e.py"):
    source = src / name
    temp = dst / ("." + name + ".boot.tmp")
    temp.write_bytes(source.read_bytes())
    compile(temp.read_text(encoding="utf-8"), str(temp), "exec")
    os.replace(temp, dst / name)
PY_AOT_BOOT_REPLACE
  then
    echo "[LỖI] Không cài được AOT runtime."
    rm -rf "$stage"
    return 1
  fi

  rm -rf "$stage"
  chmod 700 \
    "$AOT_RUNTIME_DIR/controller.py" \
    "$AOT_RUNTIME_DIR/relay.py" \
    "$AOT_RUNTIME_DIR/runtime.py" \
    "$AOT_RUNTIME_DIR/e2e.py"

  if "$PYTHON" "$AOT_RUNTIME_DIR/runtime.py" auto-start >> "$AOT_LOG" 2>&1; then
    echo "[OK] AOT Group Control auto-start đã xử lý."
  else
    echo "[WARN] AOT Group Control auto-start thất bại; xem $AOT_LOG"
  fi
}

PROVISION_REF="$(resolve_provision_ref)"

resume_provision() {
  local pid

  [ -x "$MPROVISION" ] || return 0
  provision_incomplete || return 0

  nohup env \
    AOTSCRIPT_PROVISION_REF="$PROVISION_REF" \
    "$MPROVISION" reconcile \
    >> "$LOG" 2>&1 &

  pid=$!
  echo "[OK] mprovision reconcile đã chạy nền PID=$pid"
}

{
  echo
  echo "===== AGENT BOOT $(date '+%Y-%m-%d %H:%M:%S') ====="

  termux-wake-lock 2>/dev/null || true
  sleep 15


  start_aot_group_control
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    LOCK_PID="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
    if [ -n "$LOCK_PID" ] &&
       kill -0 "$LOCK_PID" 2>/dev/null; then
      echo "[SKIP] Tiến trình khác đang xử lý Agent."
      exit 0
    fi
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null || {
      echo "[SKIP] Không lấy được khóa khởi động Agent."
      exit 0
    }
  fi

  echo "$$" > "$LOCK_DIR/pid"

  cleanup_lock() {
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
  }
  trap cleanup_lock EXIT INT TERM

  mapfile -t RUNNING_AGENT_PIDS < <(list_agent_pids)

  if [ "${#RUNNING_AGENT_PIDS[@]}" -gt 0 ]; then
    echo "[SKIP] Agent đang chạy, không khởi động thêm:"
    printf '[PID] %s\n' "${RUNNING_AGENT_PIDS[@]}"
    resume_provision
    exit 0
  fi

  if [ ! -s "$ID_FILE" ]; then
    echo "[SKIP] Chưa có hoặc file trống: $ID_FILE"
    exit 0
  fi

  if [ ! -s "$GROUP_FILE" ]; then
    echo "[SKIP] Chưa có hoặc file trống: $GROUP_FILE"
    exit 0
  fi

  DEVICE_ID_RAW="$(
    tr -d '\r\n ' < "$ID_FILE"
  )"

  DEVICE_ID="$(
    printf '%s' "$DEVICE_ID_RAW" |
      tr '[:upper:]' '[:lower:]'
  )"

  if [[ "$DEVICE_ID" =~ ^m[1-9][0-9]{0,5}$ ]]; then
    echo "[OK] device_id=$DEVICE_ID"
  else
    LEGACY_ID="$(
      printf '%s' "$DEVICE_ID_RAW" |
        tr '[:lower:]' '[:upper:]'
    )"
    case "$LEGACY_ID" in
      MARMOT-0[1-9]|MARMOT-10|NOVA-0[1-9]|NOVA-10)
        echo "[OK] device_id cũ=$LEGACY_ID"
        ;;
      *)
        echo "[SKIP] device_id không hợp lệ: $DEVICE_ID_RAW"
        exit 0
        ;;
    esac
  fi

  DEVICE_GROUP="$(
    tr -d '\r\n ' < "$GROUP_FILE" |
      tr '[:lower:]' '[:upper:]'
  )"

  case "$DEVICE_GROUP" in
    MARMOT|NOVA)
      echo "[OK] device_group=$DEVICE_GROUP"
      ;;
    *)
      echo "[SKIP] device_group không hợp lệ: $DEVICE_GROUP"
      exit 0
      ;;
  esac

  if [ ! -s "$CONFIG_FILE" ]; then
    echo "[SKIP] Chưa có hoặc file trống: $CONFIG_FILE"
    exit 0
  fi

  if ! "$PYTHON" - "$CONFIG_FILE" <<'PY'
import json
import pathlib
import sys
import urllib.parse

try:
    data = json.loads(
        pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
    )
except Exception:
    raise SystemExit(1)

if not isinstance(data, dict):
    raise SystemExit(1)

url = data.get("worker_report_url")
secret = data.get("agent_report_secret")

if not isinstance(url, str) or not url.strip():
    raise SystemExit(1)

parsed = urllib.parse.urlparse(url.strip())

if parsed.scheme not in {"http", "https"} or not parsed.netloc:
    raise SystemExit(1)

if not isinstance(secret, str) or not secret.strip():
    raise SystemExit(1)
PY
  then
    echo "[SKIP] agent_config.json không hợp lệ."
    exit 0
  fi

  rm -f "$TEMP"

  if ! "$CURL" -fsSL \
    --retry 3 \
    --connect-timeout 15 \
    "https://raw.githubusercontent.com/tinhpr9/Aotscript/$PROVISION_REF/agent?t=$(date +%s)" \
    -o "$TEMP"
  then
    echo "[LỖI] Không tải được Agent từ GitHub."
    rm -f "$TEMP"
    exit 1
  fi

  if ! "$PYTHON" -c '
import pathlib
import sys
source = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
compile(source, sys.argv[1], "exec")
' "$TEMP"
  then
    echo "[LỖI] Agent tải về sai cú pháp."
    rm -f "$TEMP"
    exit 1
  fi

  if [ -f "$AGENT" ] &&
     cmp -s "$TEMP" "$AGENT"; then
    rm -f "$TEMP"
    echo "[OK] Agent hiện tại đã là bản mới nhất."
  else
    [ ! -f "$AGENT" ] ||
      cp -p "$AGENT" "${AGENT}.bak"
    mv -f "$TEMP" "$AGENT"
    chmod 600 "$AGENT"
    echo "[OK] Đã thay Agent bằng bản hợp lệ mới nhất."
  fi

  nohup "$PYTHON" -u "$AGENT" >> "$LOG" 2>&1 &
  PID=$!
  sleep 2

  if kill -0 "$PID" 2>/dev/null; then
    echo "[OK] Đã khởi động Agent PID=$PID"
  else
    echo "[LỖI] Agent thoát ngay sau khi khởi động."
    exit 1
  fi

  resume_provision
} >> "$LOG" 2>&1
