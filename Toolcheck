    else:
        input_str = str(preset_m_code)
        print(f"=> Tự động chọn mã M: {input_str}")

    m_codes_requested = []
    raw_codes = re.split(r'[,\s]+', input_str.strip())
    for code in raw_codes:
        code = code.strip().lower()
        if not code: continue
        match = re.match(r'^m?(\d+)$', code)
        norm = "m" + match.group(1) if match else code
        if norm not in m_codes_requested:
            m_codes_requested.append(norm)

    targets = []
    m_valid = []

    if m_codes_requested:
        if not os.path.exists(ACC_FILE_PATH):
            return print(f"\n[!] LỖI: Không tìm thấy file {ACC_FILE_PATH}. Vui lòng chọn 'y' ở bước tải để hệ thống kéo file về!")

        try:
            acc_lines = open(ACC_FILE_PATH, "r", encoding="utf-8").readlines()
            sections = {}
            current_m = None

            for line in acc_lines:
                clean_line = line.strip()
                if not clean_line: continue

                match = re.match(r'^m(\d+)([^a-z0-9]|$)(.*)', clean_line.lower())
                is_header = False
                if match:
                    m_num, sep, suffix = match.groups()
                    if sep == ':' and suffix.strip() != '':
                        pass # It's a User:Pass account, not a header
                    else:
                        current_m = "m" + m_num
                        if current_m not in sections:
                            sections[current_m] = []
                        is_header = True

                if not is_header:
                    if current_m and ":" in clean_line:
                        sections[current_m].append(clean_line)

            seen_users = set()
            for m in m_codes_requested:
                if m not in sections:
                    print(f"[-] {m.upper()}: Không tồn tại")
                elif not sections[m]:
                    print(f"[-] {m.upper()}: Tồn tại nhưng trống")
                    m_valid.append(m)
                else:
                    count = 0
                    for acc in sections[m]:
                        user = acc.split(":")[0].strip()
                        if user not in seen_users:
                            seen_users.add(user)
                            targets.append(acc)
                            count += 1
                    print(f"[+] {m.upper()}: Tìm thấy {count} account")
                    m_valid.append(m)

            if not targets:
                return print(f"\n[-] Dừng sạch: Không có account nào được tìm thấy từ các mã M yêu cầu!")

            print(f"\n[+] Đã vét thành công {len(targets)} acc từ các dàn trong acc.txt")
        except Exception as e:
            return print(f"\n[!] LỖI đọc file acc.txt: {e}")
    else:
        print("\n[*] Chế độ dán thủ công: Dán list User:Pass -> gõ 'END' -> Enter")
        while True:
            try:
                line = input()
                if line.strip().upper() == "END": break
                targets.append(line.strip())
            except EOFError: break
        if not targets: return

    found_lines, found_cookies = [], []
    for target in targets:
        user = target.split(":")[0].strip() if target else ""
        if user in db:
            found_lines.append(db[user])
            found_cookies.append(":".join(db[user].split(":")[2:]))

    print("\n" + "="*50)
    if found_lines:
        open(FOUND_RESULT_FILE, "w", encoding="utf-8").write("\n".join(found_lines) + "\n")
        open(COOKIE_FILE, "w", encoding="utf-8").write("\n".join(found_cookies) + "\n")
        print(f" [THÀNH CÔNG] TÌM THẤY {len(found_lines)}/{len(targets)} TÀI KHOẢN!")
    else: print("[-] XU CÀ NA: Không tìm thấy Cookie nào khớp!")

    if m_codes_requested:
        print(f"M_SELECTED={','.join(m.upper() for m in m_codes_requested)}")
        print(f"M_VALID={','.join(m.upper() for m in m_valid)}")
        print(f"TARGETS={len(targets)}")
        print(f"FOUND={len(found_lines)}")
        print(f"NOT_FOUND={len(targets) - len(found_lines)}")

