def parse_download_files(download_data):
    ftypes = []
    if isinstance(download_data, dict):
        ftypes = list(download_data.keys())
    elif isinstance(download_data, list):
        for item in download_data:
            if isinstance(item, dict): ftypes.append(item.get("type", ""))
            else: ftypes.append(str(item))
    return [f for f in ftypes if f]

def cookie_checker():
    try:
        cookies_text = open(COOKIE_FILE, "r", encoding="utf-8").read().strip()
        if not cookies_text: return print(f"\n[!] LỖI: File trống.")

        print("\n[*] Đang Submit lên Cookie Checker...")
        headers = {"X-API-Key": COOKIE_API_KEY, "Content-Type": "application/json"}
        res = requests.post(f"{COOKIE_URL}/submit", headers=headers, json={"cookies": cookies_text})
        
        if res.status_code in [401, 403]: return print(f"[!] LỖI API: Key không hợp lệ.")
        elif res.status_code == 429: return print(f"[!] LỖI RATE LIMIT: Đợi {res.json().get('cooldown', 20)}s.")
        elif res.status_code != 200: return print(f"[!] LỖI API: Mã {res.status_code}")
        
        session_id = res.json().get("session_id")
        while True:
            time.sleep(2)
            st_res = requests.get(f"{COOKIE_URL}/status/{session_id}", headers=headers)
            if st_res.status_code != 200: continue
            st_data = st_res.json()
            st = st_data.get("status")
            print(f"\r   -> [{st.upper()}] Tiến độ: {st_data.get('checked', 0)}/{st_data.get('total', 0)}    ", end="", flush=True)
            
            if st in ["completed", "error"]:
                print() 
                if st == "completed" and st_data.get("download_files"):
                    live_cookies_found = [] 
                    
                    ftypes_to_download = parse_download_files(st_data["download_files"])
                    
                    for ftype in ftypes_to_download:
                        save_path = os.path.join(BASE_DIR, f"Cookie_{ftype}_result.txt")
                        dl_res = requests.get(f"{COOKIE_URL}/download/{session_id}/{ftype}", headers=headers)
                        
                        # MÀNG LỌC RÁC
                        if dl_res.status_code != 200 or '{"error"' in dl_res.text:
                            print(f"    -> [!] API ZeroPoint lỗi khi tải {ftype}, đã tự động bỏ qua...")
                            continue
                        
                        raw_lines = [c.strip() for c in dl_res.text.splitlines() if c.strip()]
                        mapped_lines = []
                        
                        if os.path.exists(FOUND_RESULT_FILE):
                            full_db = [line.strip() for line in open(FOUND_RESULT_FILE, "r", encoding="utf-8").readlines() if line.strip()]
                            for cookie in raw_lines:
                                found_match = False
                                for db_line in full_db:
                                    if cookie in db_line: 
                                        mapped_lines.append(db_line)
                                        found_match = True
                                        break
                                if not found_match:
                                    mapped_lines.append(cookie) 
                        else:
                            mapped_lines = raw_lines

                        final_content = "\n".join(mapped_lines) + "\n" if mapped_lines else ""
                        open(save_path, "w", encoding="utf-8").write(final_content)
                        print(f"[+] Đã lưu: {save_path}")

                        if "live" in ftype.lower() or "valid" in ftype.lower():
                            live_cookies_found.extend(raw_lines)
                            if SHEET_WEBHOOK and mapped_lines:
                                try: requests.post(SHEET_WEBHOOK, json={"delete_accounts": mapped_lines})
                                except Exception: pass

                        if any(k in ftype.lower() for k in ["lock", "face", "checkpoint"]) and mapped_lines:
                            open(FACE_TARGET_CONFIG, "w", encoding="utf-8").write(save_path)
                            print(f"    -> [AUTO-LINK & FORWARD] Đã nạp {len(mapped_lines)} acc khoá sang Face Unlock!")
                            if SHEET_WEBHOOK:
                                try: requests.post(SHEET_WEBHOOK, json={"accounts": mapped_lines})
                                except: pass

                        elif mapped_lines and os.path.exists(FOUND_RESULT_FILE) and "live" not in ftype.lower():
                            print(f"    -> [AUTO-LINK] Đã ghép thành công User:Pass cho file này!")
                            
                    if live_cookies_found:
                        print(f"\n[*] [AUTO-CLEAN] Đang dọn dẹp file gốc...")
                        cleaned_status = False
                        if os.path.exists(FOUND_RESULT_FILE):
                            old_lines = open(FOUND_RESULT_FILE, "r", encoding="utf-8").read().splitlines()
                            new_lines = [line for line in old_lines if not any(lc in line for lc in live_cookies_found)]
                            open(FOUND_RESULT_FILE, "w", encoding="utf-8").write("\n".join(new_lines) + "\n" if new_lines else "")
                            cleaned_status = True
                        if os.path.exists(COOKIE_FILE):
                            old_cookies = open(COOKIE_FILE, "r", encoding="utf-8").read().splitlines()
                            new_cookies = [c for c in old_cookies if c not in live_cookies_found]
                            open(COOKIE_FILE, "w", encoding="utf-8").write("\n".join(new_cookies) + "\n" if new_cookies else "")
                        if cleaned_status: print("    -> [DONE] Quét dọn hoàn tất!")
                break
    except Exception as e: print(f"\n[!] LỖI HỆ THỐNG: {e}")

