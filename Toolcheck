def force_clear_jobs():
    headers = {"X-API-Key": FACE_API_KEY, "Content-Type": "application/json"}
    print("\n[*] Đang quét các Job treo trên server ZeroPoint...")
    try:
        res = requests.get(f"{FACE_URL}/active", headers=headers)
        if res.status_code == 200:
            jobs = res.json().get("jobs", [])
            if not jobs:
                print("[+] Không có job nào đang kẹt.")
                return True
            for job in jobs:
                jid = job.get("job_id")
                print(f"[*] Đang ép HỦY job: {jid}")
                requests.post(f"{FACE_URL}/cancel/{jid}", headers=headers)
            print("[*] Đang chờ 4 giây để server đồng bộ xóa dữ liệu...")
            time.sleep(4)
            return True
        else:
            print(f"[!] Lỗi quét job: {res.text}")
            return False
    except Exception as e:
        print(f"[!] Lỗi hệ thống: {e}")
        return False

