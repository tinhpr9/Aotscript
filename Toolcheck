        choice = str(download_choice).strip().lower()
        print(f"[*] Tự động chọn tải dữ liệu: {choice.upper()}")

    ACC_FILE_PATH = os.path.join(BASE_DIR, "acc.txt")

    if choice == 'y':
        print("\n[*] Đang kết nối Google Drive...")
        file_id_data = "1k8B2Vkdu-w3-K-O92vMeC1HQbKGaZb0B"
        file_id_acc = "12oxXXlSPvHbB0YRUMQcHhLHiE4gemiVg"
        url = "https://docs.google.com/uc?export=download"
        session = requests.Session()
        
        def download_drive(fid, save_path, name):
            try:
                res = session.get(url, params={'id': fid}, stream=True)
                token = None
                for key, value in res.cookies.items():
                    if key.startswith("download_warning"):
                        token = value
                        break
                if token:
                    res = session.get(url, params={'id': fid, 'confirm': token}, stream=True)
                
                with open(save_path, "wb") as f:
                    for chunk in res.iter_content(32768):
                        if chunk: f.write(chunk)
                print(f"[+] Đã tải xong {name}: {save_path}")
            except Exception as e:
                print(f"[!] Lỗi khi tải {name}: {e}")

        download_drive(file_id_data, DB_COOKIES_FILE, "Data Tổng")
        download_drive(file_id_acc, ACC_FILE_PATH, "File acc.txt")

    try: raw_data = open(DB_COOKIES_FILE, "r", encoding="utf-8").readlines()
    except: raw_data = []
    
    if not raw_data: 
        return print(f"\n[!] LỖI: Dữ liệu {DB_COOKIES_FILE} trống hoặc không tồn tại. Hãy chạy lại và bấm 'y' để tải về!")

    db = {}
    for line in raw_data:
        parts = line.strip().split(":")
        if len(parts) >= 3: db[parts[0].strip()] = line.strip()

    print(f"\n ĐÃ TẢI {len(db)} ACCOUNT TỪ DATA TỔNG!")
    
    print("\n[?] NHẬP MÃ DÀN ACC ĐỂ QUÉT TỪ FILE acc.txt")
