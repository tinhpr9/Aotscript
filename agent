                                    "device_group": group,
                                    "timestamp": ts_succ,
                                    "status": "success",
                                    "command_id": cmd_id,
                                    "command": single_cmd,
                                    "command_index": idx_c,
                                    "command_total": len(group_cmds),
                                    "last_result": "ok",
                                }
                                try:
                                    send_report_to_worker(report_url, secret, payload_succ)
                                except Exception:
                                    pass
                                state["last_result"] = "ok"
                                save_state(state)

                            except Exception as e:
                                short_err = str(e)
                                if len(short_err) > 240:
                                    short_err = short_err[:237] + "..."
                                ts_err = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
                                payload_err = {
                                    "device_id": device_id,
                                    "device_group": group,
                                    "timestamp": ts_err,
                                    "status": "error",
                                    "command_id": cmd_id,
                                    "command": single_cmd,
                                    "command_index": idx_c,
                                    "command_total": len(group_cmds),
                                    "last_result": short_err,
                                }
                                try:
                                    send_report_to_worker(report_url, secret, payload_err)
                                except Exception:
                                    pass
                                state["last_result"] = short_err
                                save_state(state)

                        i = j
                        continue
                # generic comment: skip
                i += 1
                continue

            # non-comment single command (no command_id)
            # treat as before but also send running/success/error without command_id
            single_cmd = raw
            total_detected += 1
            # report running
            cfg = cfg if 'cfg' in globals() else load_agent_config()
            report_url = cfg.get("worker_report_url")
            secret = cfg.get("agent_report_secret")
            ts_run = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
            payload_run = {
                "device_id": device_id,
                "device_group": group,
                "timestamp": ts_run,
                "status": "running",
                "command_id": None,
                "command": single_cmd,
            }
            try:
                send_report_to_worker(report_url, secret, payload_run)
            except Exception:
                pass

            try:
                if single_cmd.startswith("Updatescript "):
                    link = single_cmd.split(" ", 1)[1].strip()
                    install_custom_script(link)

                elif single_cmd == "RELOAD_NOVAGAG2":
                    if group != "NOVA":
                        raise RuntimeError(
                            "RELOAD_NOVAGAG2 chỉ hợp lệ cho NOVA"
                        )
                    if not install_group_script(group):
                        raise RuntimeError(
                            "Không thể nạp lại Novagag2"
                        )

                elif single_cmd == "UPDATE_DELTA":
                    auto_update_system()

                elif single_cmd.startswith("UPDATE_SOLVER"):
                    parts = single_cmd.split(" ", 1)
                    if len(parts) > 1:
                        update_solver_url(parts[1].strip())

                elif single_cmd == "INSTALL_TRACK":
                    install_qhtrack()

                elif single_cmd == "SETUP_CAYLAPBU":
                    setup_termux_caylapbu()

                elif single_cmd == "RUN_CAYLAPBU":
                    run_termux_caylapbu()

                elif single_cmd == "SETUP_BOOT":
                    setup_termux_boot()

                elif single_cmd == "SETUP_VIP":
                    setup_vip_servers()

                elif single_cmd == "REBOOT":
                    reboot_device()

                elif single_cmd == "IDLE":
                    print("[💤] Đã nhận lệnh nghỉ ngơi.")

                ts_succ = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
                payload_succ = {
                    "device_id": device_id,
                    "device_group": group,
                    "timestamp": ts_succ,
                    "status": "success",
                    "command_id": None,
                    "command": single_cmd,
                    "last_result": "ok",
                }
                try:
                    send_report_to_worker(report_url, secret, payload_succ)
                except Exception:
                    pass
                state["last_result"] = "ok"
                save_state(state)

            except Exception as e:
                short_err = str(e)
                if len(short_err) > 240:
                    short_err = short_err[:237] + "..."
                ts_err = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
                payload_err = {
                    "device_id": device_id,
                    "device_group": group,
                    "timestamp": ts_err,
                    "status": "error",
                    "command_id": None,
                    "command": single_cmd,
                    "last_result": short_err,
                }
                try:
                    send_report_to_worker(report_url, secret, payload_err)
                except Exception:
                    pass
                state["last_result"] = short_err
                save_state(state)

            i += 1

        print(f"\n[*] ĐÃ THỰC HIỆN XONG TOÀN BỘ LỆNH. CHỜ VIỆC TIẾP THEO...\nDetected {total_detected} actionable lines.")
        time.sleep(15)
