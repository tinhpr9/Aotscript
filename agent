def update_solver_url(new_url):
    print(f"\n[*] ĐANG TIẾN HÀNH TRÁO LINK SOLVER...")
    
    if "raw.githubusercontent.com" in new_url:
        print("[*] Phát hiện link GitHub, đang bóc tách link gốc...")
        try:
            req = urllib.request.Request(new_url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=10) as response:
                new_url = response.read().decode('utf-8').strip()
                print(f"[+] Lấy link gốc thành công: {new_url[:30]}...")
        except Exception as e:
            log_error("update_solver_url_fetch", e)
            return

    if not os.path.exists(CONFIG_PATH):
        return print(f"[!] Lỗi: Không tìm thấy file {CONFIG_PATH} trong máy ảo.")
    
    try:
        with open(CONFIG_PATH, 'r', encoding='utf-8') as f:
            content = f.read()
        
        updated_content = re.sub(r'"solver_url":\s*"[^"]*"', f'"solver_url": "{new_url}"', content)
        
        with open(CONFIG_PATH, 'w', encoding='utf-8') as f:
            f.write(updated_content)
            
        print(f"[+] Thành công! Đã cấy link solver thật vào config.json")
    except Exception as e:
        log_error("update_solver_url_write", e)

