def setup_termux_boot():
    print("\n[*] ĐANG CÀI BOOT SCRIPT AN TOÀN TỪ GITHUB...")

    raw_url = (
        "https://raw.githubusercontent.com/"
        "tinhpr9/Aotscript/main/Termuxboot"
        f"?t={int(time.time())}"
    )
    boot_dir = "/data/data/com.termux/files/home/.termux/boot"
    target = os.path.join(boot_dir, "01-agent.sh")
    temp = target + ".tmp"
    backup = (
        target
        + ".bak-"
        + datetime.datetime.utcnow().strftime("%Y%m%d-%H%M%S")
    )

    try:
        os.makedirs(boot_dir, exist_ok=True)
        req = urllib.request.Request(
            raw_url,
            headers={
                "User-Agent": "Mozilla/5.0",
                "Cache-Control": "no-cache",
            },
        )

        with urllib.request.urlopen(req, timeout=15) as response:
            content = response.read()

        if not content.strip():
            raise RuntimeError("Empty Termuxboot response")

        with open(temp, "wb") as f:
            f.write(content)

        syntax = subprocess.run(
            [
                "/data/data/com.termux/files/usr/bin/bash",
                "-n",
                temp,
            ],
            capture_output=True,
            text=True,
            timeout=15,
        )

        if syntax.returncode != 0:
            raise RuntimeError("Downloaded Termuxboot failed bash -n")

        if os.path.exists(target):
            with open(target, "rb") as f:
                current = f.read()

            if current == content:
                os.remove(temp)
                os.chmod(target, 0o700)
                print("[+] 01-agent.sh đã là bản an toàn mới nhất.")
                return

            shutil.copy2(target, backup)

        os.replace(temp, target)
        os.chmod(target, 0o700)
        print("[+] Đã cài 01-agent.sh an toàn; giữ nguyên boot script khác.")
    except Exception as e:
        if os.path.exists(temp):
            try:
                os.remove(temp)
            except Exception:
                pass

        log_error(
            "setup_termux_boot",
            RuntimeError(type(e).__name__),
        )


