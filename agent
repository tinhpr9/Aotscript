def reboot_device():
    reboot_commands = [
        ["su", "-c", "setprop sys.powerctl reboot"],
        ["su", "-c", "reboot"],
        ["su", "-c", "/system/bin/reboot"],
        ["su", "-c", "svc power reboot"],
    ]

    for command in reboot_commands:
        command_display = " ".join(command)
        print(f"[*] Thử phương án: {command_display}")
        try:
            result = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=10,
            )
            if result.returncode == 0:
                print(f"[+] Lệnh reboot được chấp nhận: {command_display}")
                if result.stdout:
                    print(f"[stdout] {result.stdout.strip()}")
                if result.stderr:
                    print(f"[stderr] {result.stderr.strip()}")
                time.sleep(5)
                return
            print(f"[!] Lỗi khi chạy: {command_display} returncode={result.returncode}")
            if result.stdout:
                print(f"[stdout] {result.stdout.strip()}")
            if result.stderr:
                print(f"[stderr] {result.stderr.strip()}")
        except Exception as e:
            print(f"[!] Exception khi chạy: {command_display}: {e}")
            log_error("reboot_device", e)

    log_error("reboot_device", RuntimeError("Tất cả phương án reboot đều thất bại"))
    print("[!] Không thể reboot thiết bị bằng các phương án hiện tại.")


def reconcile_termux_boot():
    try:
        setup_termux_boot()

        if not os.path.isfile(
            TERMUX_BOOT_PATH
        ):
            return (
                False,
                "boot_missing",
            )

        os.chmod(
            TERMUX_BOOT_PATH,
            0o700,
        )

        bash_path = (
            shutil.which("bash")
            or (
                "/data/data/com.termux/"
                "files/usr/bin/bash"
            )
        )

        result = subprocess.run(
            [
                bash_path,
                "-n",
                TERMUX_BOOT_PATH,
            ],
            capture_output=True,
            text=True,
            timeout=20,
        )

        if result.returncode != 0:
            return (
                False,
                "boot_invalid",
            )

        return (
            True,
            "boot_ok",
        )

    except Exception as error:
        log_error(
            "reconcile_termux_boot",
            RuntimeError(
                type(error).__name__
            ),
        )

        return (
            False,
            (
                "boot_error_"
                + type(error).__name__
            ),
        )


def agent_process_count():
    pgrep_path = shutil.which(
        "pgrep"
    )

    if not pgrep_path:
        return None

    try:
        result = subprocess.run(
            [
                pgrep_path,
                "-af",
                (
                    "[/]Download/"
                    "Agent_Core.py"
                ),
            ],
            capture_output=True,
            text=True,
            timeout=5,
        )

        if result.returncode == 1:
            return 0

        if result.returncode != 0:
            return None

        return len([
            line
            for line
            in result.stdout.splitlines()
            if line.strip()
        ])

    except Exception:
        return None


def reconcile_system_state(
    state,
    group,
    force=False,
):
    global SYSTEM_RECONCILE_LAST_RUN

    now = time.monotonic()

    if (
        not force
        and SYSTEM_RECONCILE_LAST_RUN
        is not None
        and (
            now
            - SYSTEM_RECONCILE_LAST_RUN
            < SYSTEM_RECONCILE_INTERVAL_SECONDS
        )
    ):
        return (
            state.get(
                "setup_health"
            )
            != "degraded"
        )

    SYSTEM_RECONCILE_LAST_RUN = now

    state["setup_health"] = (
        "repairing"
    )

    state[
        "needs_manual_action"
    ] = False

    save_state(state)

    repaired = []
    issues = []

    try:
        os.makedirs(
            os.path.dirname(
                STATE_PATH
            ),
            exist_ok=True,
        )

        os.makedirs(
            AUTOEXECUTE_DIR,
            exist_ok=True,
        )

        repaired.append(
            "directories_ok"
        )

    except Exception:
        issues.append(
            "required_directories"
        )

    if load_device_id() is None:
        issues.append(
            "device_id"
        )

    if group not in GROUP_SCRIPT_URLS:
        issues.append(
            "device_group"
        )

    if not load_agent_config():
        issues.append(
            "agent_config"
        )

    if group in GROUP_SCRIPT_URLS:
        if reconcile_autoexecute(
            group,
            force=True,
        ):
            repaired.append(
                "autoexecute_ok"
            )
        else:
            issues.append(
                "autoexecute"
            )

    boot_ok, boot_result = (
        reconcile_termux_boot()
    )

    if boot_ok:
        repaired.append(
            boot_result
        )
    else:
        issues.append(
            boot_result
        )

    process_count = (
        agent_process_count()
    )

    if process_count is not None:
        repaired.append(
            (
                "agent_processes="
                f"{process_count}"
            )
        )

        if process_count > 1:
            issues.append(
                "duplicate_agent_processes"
            )

    timestamp = (
        datetime.datetime.utcnow()
        .strftime(
            "%Y-%m-%dT%H:%M:%SZ"
        )
    )

    state["setup_health"] = (
        "degraded"
        if issues
        else "healthy"
    )

    state[
        "last_reconcile_at"
    ] = timestamp

    state[
        "needs_manual_action"
    ] = bool(issues)

    details = (
        issues
        if issues
        else repaired
    )

    if not details:
        details = [
            "no_change"
        ]

    result = (
        (
            "degraded: "
            if issues
            else "ok: "
        )
        + ", ".join(details)
    )

    state[
        "last_repair_result"
    ] = result[:500]

    save_state(state)

    print(
        "[+] RECONCILE_SYSTEM: "
        + result
    )

    return not issues


# Hàm 1: Tự động quét Github, tải và cài đặt Delta
# BEGIN DELTA RELEASE SELECTOR
def _delta_asset_kind(name):
    value = str(name or "").strip()
    lower = value.lower()

    if lower.startswith("delta-") and lower.endswith(".apk"):
        return "apk"

    if lower.startswith("download") and lower.endswith(".zip"):
        return "zip"

    return ""


def _safe_delta_name(name):
    value = str(name or "").strip()
    safe = "".join(
        ch if ch.isalnum() or ch in "._-" else "_"
        for ch in value
    )
    return safe or "delta_asset"


def _github_release_pages():
    headers = {
        "User-Agent": "Aotscript-Delta-Updater",
        "Accept": "application/vnd.github+json",
    }

    for page in range(1, 6):
        api_url = (
            f"https://api.github.com/repos/{OWNER}/{REPO}/releases"
            f"?per_page=100&page={page}"
        )

        req = urllib.request.Request(
            api_url,
            headers=headers,
        )

        with urllib.request.urlopen(
            req,
            timeout=20,
        ) as response:
            releases = json.loads(
                response.read().decode("utf-8")
            )

        if not isinstance(releases, list):
            raise RuntimeError(
                "GitHub releases API trả dữ liệu không hợp lệ"
            )

        if not releases:
            break

        for release in releases:
            if isinstance(release, dict):
                yield release

        if len(releases) < 100:
            break


def _select_delta_release():
    zip_fallback = None

    for release in _github_release_pages():
        tag = str(
            release.get("tag_name", "")
        ).strip()
        title = str(
            release.get("name", "")
        ).strip()

        tag_lower = tag.lower()
        title_lower = title.lower()

        # AOT Worker release tuyệt đối không phải Delta channel.
        if (
            tag_lower.startswith("worker-v")
            or "aot worker" in title_lower
        ):
            continue

        direct_apks = []
        zip_assets = []

        for asset in release.get("assets", []):
            if not isinstance(asset, dict):
                continue

            name = str(
                asset.get("name", "")
            ).strip()
            url = str(
                asset.get(
                    "browser_download_url",
                    "",
                )
            ).strip()

            kind = _delta_asset_kind(name)

            if not kind or not url:
                continue

            item = {
                "name": name,
                "url": url,
                "kind": kind,
            }

            if kind == "apk":
                direct_apks.append(item)
            else:
                zip_assets.append(item)

        # Ưu tiên release có Delta-*.apk trực tiếp.
        if direct_apks:
            return release, direct_apks + zip_assets

        # Fallback cho release Delta chỉ đóng gói Download*.zip.
        if zip_assets and zip_fallback is None:
            zip_fallback = (
                release,
                zip_assets,
            )

    if zip_fallback is not None:
        return zip_fallback

    raise RuntimeError(
        "Không tìm thấy GitHub Release chứa Delta APK/ZIP hợp lệ"
    )


def _download_delta_asset(url, destination):
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "Aotscript-Delta-Updater",
        },
    )

    written = 0

    with urllib.request.urlopen(
        req,
        timeout=60,
    ) as response, open(
        destination,
        "wb",
    ) as output:
        while True:
            chunk = response.read(
                1024 * 1024
            )

            if not chunk:
                break

            output.write(chunk)
            written += len(chunk)

    if written <= 0:
        raise RuntimeError(
            f"Asset tải về rỗng: {destination}"
        )


def _install_delta_apk(apk_path):
    command = (
        "pm install -r '"
        + str(apk_path)
        + "'"
    )

    result = subprocess.run(
        ["su", "-c", command],
        capture_output=True,
        text=True,
        timeout=180,
    )

    output = (
        (result.stdout or "")
        + "\n"
        + (result.stderr or "")
    ).strip()

    if (
        result.returncode != 0
        or "Success" not in output
    ):
        raise RuntimeError(
            "pm install thất bại cho "
            f"{apk_path}: {output[:500]}"
        )


def _iter_delta_zip_apks(
    zip_path,
    output_dir,
):
    os.makedirs(
        output_dir,
        exist_ok=True,
    )

    count = 0
    total_size = 0

    with zipfile.ZipFile(
        zip_path,
        "r",
    ) as archive:
        bad = archive.testzip()

        if bad is not None:
            raise RuntimeError(
                f"ZIP CRC lỗi tại: {bad}"
            )

        for member in archive.infolist():
            if member.is_dir():
                continue

            member_name = (
                member.filename
                .replace("\\", "/")
            )

            if not member_name.lower().endswith(
                ".apk"
            ):
                continue

            # Chống ZIP bất thường/bomb.
            if member.file_size > 1024 * 1024 * 1024:
                raise RuntimeError(
                    "APK trong ZIP vượt 1 GiB"
                )

            total_size += member.file_size

            if total_size > 8 * 1024 * 1024 * 1024:
                raise RuntimeError(
                    "Tổng APK trong ZIP vượt giới hạn"
                )

            count += 1

            base = _safe_delta_name(
                os.path.basename(
                    member_name
                )
            )

            destination = os.path.join(
                output_dir,
                f"{count:03d}_{base}",
            )

            with archive.open(
                member,
                "r",
            ) as src, open(
                destination,
                "wb",
            ) as dst:
                while True:
                    chunk = src.read(
                        1024 * 1024
                    )

                    if not chunk:
                        break

                    dst.write(chunk)

            yield destination

    if count == 0:
        raise RuntimeError(
            f"Delta ZIP không chứa APK: {zip_path}"
        )


def auto_update_system():
    print("=" * 50)
    print("   AOTSCRIPT UPDATE DELTA")
    print("=" * 50)

    os.makedirs(
        DOWNLOAD_DIR,
        exist_ok=True,
    )

    try:
        release, assets = (
            _select_delta_release()
        )

        tag = str(
            release.get(
                "tag_name",
                "",
            )
        ).strip()

        title = str(
            release.get(
                "name",
                "",
            )
        ).strip()

        print(
            "[+] Delta Release: "
            f"{title or tag} [{tag}]"
        )

        print(
            "[+] Delta assets hợp lệ: "
            f"{len(assets)}"
        )

        installed = 0

        for index, asset in enumerate(
            assets,
            1,
        ):
            name = asset["name"]
            kind = asset["kind"]

            safe_name = (
                _safe_delta_name(name)
            )

            file_path = os.path.join(
                DOWNLOAD_DIR,
                f"delta_{index:03d}_{safe_name}",
            )

            print(
                f"[{index}/{len(assets)}] "
                f"Tải {name}"
            )

            _download_delta_asset(
                asset["url"],
                file_path,
            )

            if kind == "apk":
                print(
                    f"    -> Cài {name}"
                )

                _install_delta_apk(
                    file_path
                )

                installed += 1
                continue

            apk_dir = os.path.join(
                DOWNLOAD_DIR,
                "delta_extract_"
                f"{index:03d}",
            )

            zip_installed = 0

            for apk_path in (
                _iter_delta_zip_apks(
                    file_path,
                    apk_dir,
                )
            ):
                print(
                    "    -> Cài "
                    + os.path.basename(
                        apk_path
                    )
                )

                _install_delta_apk(
                    apk_path
                )

                zip_installed += 1
                installed += 1

            if zip_installed <= 0:
                raise RuntimeError(
                    f"Không cài được APK nào từ {name}"
                )

        if installed <= 0:
            raise RuntimeError(
                "UPDATE_DELTA kết thúc nhưng zero APK installed"
