def fetch_text(url, source_name):
    try:
        parsed = urllib.parse.urlparse(url)
        if parsed.scheme not in ("http", "https") or not parsed.netloc:
            raise ValueError(f"Invalid URL: {url}")
        sep = "&" if parsed.query else "?"
        fetch_url = f"{url}{sep}t={int(time.time())}"
        headers = {
            "User-Agent": "Mozilla/5.0",
            "Cache-Control": "no-cache, no-store, must-revalidate",
            "Pragma": "no-cache",
            "Expires": "0",
        }
        req = urllib.request.Request(fetch_url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as response:
            return response.read().decode("utf-8")
    except Exception as e:
        log_error(f"fetch_text_{source_name}", e)
        return None


def get_command_sources(group):
    sources = [("COMMON", COMMON_COMMAND_URL)]
    if group in GROUP_COMMAND_URLS:
        sources.append((group, GROUP_COMMAND_URLS[group]))
    return sources


def fetch_commands_for_group(group):
    if not group:
        return None, None
    common_text = fetch_text(COMMON_COMMAND_URL, "COMMON")
    group_text = fetch_text(GROUP_COMMAND_URLS.get(group, ""), group)
    return common_text, group_text


def is_valid_url(url):
    if "\n" in url or "\r" in url:
        return False
    try:
        parsed = urllib.parse.urlparse(url)
        return parsed.scheme in ("http", "https") and bool(parsed.netloc)
    except Exception:
        return False



def expected_group_script_content(group):
    if group not in GROUP_SCRIPT_URLS:
        raise ValueError(
            f"Unsupported group: {group}"
        )

    script_url = GROUP_SCRIPT_URLS[group]

    if not is_valid_url(script_url):
        raise ValueError(
            "Invalid group script URL"
        )

    separator = (
        "&"
        if "?" in script_url
        else "?"
    )

    return (
        'loadstring(game:HttpGet("'
        + script_url
        + separator
        + 't=" .. tostring(os.time())))()'
        + "\n"
    )


def group_script_is_current(group):
    try:
        expected = (
            expected_group_script_content(
                group
            )
        )

        with open(
            GROUP_SCRIPT_FILE,
            "r",
            encoding="utf-8",
        ) as file:
            actual = file.read()

        return actual == expected

    except Exception:
        return False


def managed_loader_groups(content):
    lowered = content.lower()
    detected = set()

    for group, markers in (
        MANAGED_LOADER_MARKERS.items()
    ):
        for marker in markers:
            if marker.lower() in lowered:
                detected.add(group)
                break

    return detected


def unique_backup_path(
    directory,
    name,
):
    candidate = os.path.join(
        directory,
        name,
    )

    if not os.path.exists(candidate):
        return candidate

    stem, suffix = os.path.splitext(
        name
    )
    index = 1

    while True:
        candidate = os.path.join(
            directory,
            f"{stem}.{index}{suffix}",
        )

        if not os.path.exists(candidate):
            return candidate

        index += 1


def create_autoexecute_backup_directory():
    os.makedirs(
        AUTOEXECUTE_BACKUP_ROOT,
        exist_ok=True,
    )

    timestamp = (
        datetime.datetime.utcnow()
        .strftime(
            "%Y%m%dT%H%M%SZ"
        )
    )

    candidate = os.path.join(
        AUTOEXECUTE_BACKUP_ROOT,
        timestamp,
    )
    index = 1

    while os.path.exists(candidate):
        candidate = os.path.join(
            AUTOEXECUTE_BACKUP_ROOT,
            f"{timestamp}-{index}",
        )
        index += 1

    os.makedirs(
        candidate,
        exist_ok=False,
    )

    return candidate


def write_autoexecute_manifest(
    directory,
    group,
    moved,
):
    manifest = {
        "created_at": (
            datetime.datetime.utcnow()
            .strftime(
                "%Y-%m-%dT%H:%M:%SZ"
            )
        ),
        "device_group": group,
        "managed_loader":
            os.path.basename(
                GROUP_SCRIPT_FILE
            ),
        "moved": moved,
    }

    target = os.path.join(
        directory,
        "manifest.json",
    )
    temporary = target + ".tmp"

    data = (
        json.dumps(
            manifest,
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        ).rstrip()
        + "\n"
    )

    with open(
        temporary,
        "w",
        encoding="utf-8",
        newline="\n",
    ) as file:
        file.write(data)
        file.flush()
        os.fsync(
            file.fileno()
        )

    os.replace(
        temporary,
        target,
    )


def quarantine_conflicting_loaders(group):
    if group not in GROUP_SCRIPT_URLS:
        log_error(
            "quarantine_conflicting_loaders",
            ValueError(
                f"Invalid group: {group}"
            ),
            group,
        )
        return False

    try:
        os.makedirs(
            AUTOEXECUTE_DIR,
            exist_ok=True,
        )

        backup_directory = None
        moved = []

        for entry in os.scandir(
            AUTOEXECUTE_DIR
        ):
            try:
                if not entry.is_file(
                    follow_symlinks=False
                ):
                    continue

                source_path = os.path.abspath(
                    entry.path
                )

                if source_path == os.path.abspath(
                    GROUP_SCRIPT_FILE
                ):
                    continue

                suffix = os.path.splitext(
                    entry.name
                )[1].lower()

                if suffix in {
                    ".zip",
                    ".bak",
                    ".tmp",
                    ".json",
                }:
                    continue

                size = entry.stat(
                    follow_symlinks=False
                ).st_size

                if (
                    size <= 0
                    or size
                    > AUTOEXECUTE_MAX_TEXT_BYTES
                ):
                    continue

                with open(
                    entry.path,
                    "r",
                    encoding="utf-8",
                    errors="ignore",
                ) as file:
                    loader_content = file.read(
                        AUTOEXECUTE_MAX_TEXT_BYTES
                        + 1
                    )

                if (
                    len(
                        loader_content.encode(
                            "utf-8",
                            errors="ignore",
                        )
                    )
                    > AUTOEXECUTE_MAX_TEXT_BYTES
                ):
                    continue

                detected = (
                    managed_loader_groups(
                        loader_content
                    )
                )

                if not detected:
                    continue

                reason = (
                    "conflicting_loader"
                    if any(
                        item != group
                        for item in detected
                    )
                    else "duplicate_loader"
                )

                if backup_directory is None:
                    backup_directory = (
                        create_autoexecute_backup_directory()
                    )

                destination = (
                    unique_backup_path(
                        backup_directory,
                        entry.name,
                    )
                )

                shutil.move(
                    entry.path,
                    destination,
                )

                moved.append({
                    "source_name":
                        entry.name,
                    "backup_name":
                        os.path.basename(
                            destination
                        ),
                    "reason": reason,
                    "detected_groups":
                        sorted(detected),
                })

                print(
                    "[+] AUTOEXECUTE_BACKUP: "
                    f"{entry.name} -> "
                    f"{destination} "
                    f"reason={reason}"
                )

            except Exception as entry_error:
                log_error(
                    "quarantine_conflicting_loaders_entry",
                    entry_error,
                    group,
                )

        if (
            backup_directory is not None
            and moved
        ):
            write_autoexecute_manifest(
                backup_directory,
                group,
                moved,
            )

        return True

    except Exception as error:
        log_error(
            "quarantine_conflicting_loaders",
            error,
            group,
        )
        return False


def reconcile_autoexecute(
    group,
    force=False,
):
    global AUTOEXECUTE_LAST_RECONCILE

    now = time.monotonic()

    if (
        not force
        and AUTOEXECUTE_LAST_RECONCILE
        is not None
        and (
            now
            - AUTOEXECUTE_LAST_RECONCILE
            < AUTOEXECUTE_RECONCILE_INTERVAL_SECONDS
        )
    ):
        return True

    AUTOEXECUTE_LAST_RECONCILE = now

    if not group_script_is_current(
        group
    ):
        if not install_group_script(
            group
        ):
            return False

    return quarantine_conflicting_loaders(
        group
    )

def install_group_script(group):
    if group not in GROUP_SCRIPT_URLS:
        log_error(
            "install_group_script",
            ValueError(
                f"Unsupported group: {group}"
            ),
            group,
        )
        return False

    script_url = GROUP_SCRIPT_URLS[group]

    if not is_valid_url(script_url):
        log_error(
            "install_group_script",
            ValueError(
                "Invalid group script URL"
            ),
            group,
        )
        return False

    temp_file = (
        GROUP_SCRIPT_FILE
        + ".tmp"
    )

    rollback_file = (
        GROUP_SCRIPT_FILE
        + ".rollback.tmp"
    )

    had_original = os.path.exists(
        GROUP_SCRIPT_FILE
    )

    replaced = False

    try:
        os.makedirs(
            AUTOEXECUTE_DIR,
            exist_ok=True,
        )

        ensure_parent_dir(
            GROUP_SCRIPT_BACKUP_FILE
        )

        if "?" in script_url:
            lua_body = (
                'loadstring(game:HttpGet("'
                + script_url
                + '&t=" .. tostring(os.time())))()'
            )
        else:
            lua_body = (
                'loadstring(game:HttpGet("'
                + script_url
                + '?t=" .. tostring(os.time())))()'
            )

        content = (
            lua_body.rstrip()
            + "\n"
        )

        with open(
            temp_file,
            "w",
            encoding="utf-8",
            newline="\n",
        ) as file:
            file.write(content)
            file.flush()
            os.fsync(
                file.fileno()
            )

        with open(
            temp_file,
            "r",
            encoding="utf-8",
        ) as file:
            temporary_content = (
                file.read()
            )

        if temporary_content != content:
            raise IOError(
                "Temporary group script verification failed"
            )

        if had_original:
            shutil.copy2(
                GROUP_SCRIPT_FILE,
                GROUP_SCRIPT_BACKUP_FILE,
            )

        os.replace(
            temp_file,
            GROUP_SCRIPT_FILE,
        )

        replaced = True

        with open(
            GROUP_SCRIPT_FILE,
            "r",
            encoding="utf-8",
        ) as file:
            installed_content = (
                file.read()
            )

        if installed_content != content:
            raise IOError(
                "Installed group script verification failed"
            )

        print(
            "[+] INSTALL_GROUP_SCRIPT: "
            f"group={group}, "
            f"url={script_url}, "
            f"file={GROUP_SCRIPT_FILE}"
        )

        return True

    except Exception as error:
        for temporary_path in (
            temp_file,
            rollback_file,
        ):
            if os.path.exists(
                temporary_path
            ):
                try:
                    os.remove(
                        temporary_path
                    )
                except Exception:
                    pass

        if replaced:
            try:
                if (
                    had_original
                    and os.path.exists(
                        GROUP_SCRIPT_BACKUP_FILE
                    )
                ):
                    shutil.copy2(
                        GROUP_SCRIPT_BACKUP_FILE,
                        rollback_file,
                    )

                    os.replace(
                        rollback_file,
                        GROUP_SCRIPT_FILE,
                    )

                elif os.path.exists(
                    GROUP_SCRIPT_FILE
                ):
                    os.remove(
                        GROUP_SCRIPT_FILE
                    )

            except Exception as rollback_error:
                log_error(
                    "install_group_script_rollback",
                    rollback_error,
                    group,
                )

        log_error(
            "install_group_script",
            error,
            group,
        )

        return False

