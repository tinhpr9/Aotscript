# Hàm 9: TỰ ĐỘNG BỐC THĂM LINK VIP (KHÔNG CẦN CÀI ĐẶT TAY)
def setup_vip_servers():
    print(f"\n[*] ĐANG BỐC THĂM LINK VIP TỪ KHO TỔNG...")
    try:
        import urllib.request
        import os
        import random

        # Tự động lấy ID phần cứng của máy ảo
        try:
            android_id = os.popen('su -c "settings get secure android_id" 2>/dev/null').read().strip()
            if not android_id:
                android_id = "0"
            machine_index = int(android_id, 16)
        except Exception as e:
            log_error("setup_vip_servers_hwid", e)
            machine_index = random.randint(0, 1000)

        url = f"https://raw.githubusercontent.com/tinhpr9/Aotscript/main/tong_hop_link.txt?t={int(time.time())}"
        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
        data = urllib.request.urlopen(req, timeout=10).read().decode('utf-8')

        # Tách các cụm link ra (được chia cách nhau bằng 3 dấu bằng ===)
        blocks = [block.strip() for block in data.split('===') if block.strip()]

        if not blocks:
            return print("[!] Kho link tổng đang trống hoặc sai định dạng!")

        # Bốc đúng cụm link theo thuật toán (chia lấy dư)
        my_links = blocks[machine_index % len(blocks)]

        # Lưu vào máy
        os.system("mkdir -p /storage/emulated/0/Download/Shouko")
        with open("/storage/emulated/0/Download/Shouko/server_links.txt", "w", encoding='utf-8') as f:
            f.write(my_links)

        print(f"[+] Đã chép xong cụm link VIP cho 8 acc của thiết bị này!")
    except Exception as e:
        log_error("setup_vip_servers", e)

