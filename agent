def calculate_sha256(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def command_timestamp_for_sort(text):
    # Lấy timestamp lớn nhất từ telegram_command_id để xếp nguồn lệnh.
    timestamps = []

    for match in re.finditer(
        r"telegram_command_id\s*=\s*(\d+)(?:-[\w-]+)?",
        text or "",
    ):
        try:
            timestamps.append(int(match.group(1)))
        except (TypeError, ValueError):
            continue

    return max(timestamps) if timestamps else 0


def normalize_command_device_id(value):
    raw = str(value or "").strip()

    dynamic_match = re.fullmatch(
        r"m([1-9]\d{0,5})",
        raw,
        re.IGNORECASE,
    )

    if dynamic_match:
        return f"m{dynamic_match.group(1)}"

    legacy_match = re.fullmatch(
        r"(MARMOT|NOVA)-(\d{2})",
        raw,
        re.IGNORECASE,
    )

    if not legacy_match:
        return None

    index = int(
        legacy_match.group(2)
    )

    if index < 1 or index > 10:
        return None

    return (
        f"{legacy_match.group(1).upper()}-"
        f"{index:02d}"
    )


def command_metadata_before(
    lines,
    command_index,
):
    metadata = {
        "target_ids": None,
        "expires_at": 0,
    }

    cursor = command_index - 1

    while cursor >= 0:
        raw = lines[cursor].strip()

        if not raw:
            cursor -= 1
            continue

        if not raw.startswith("#"):
            break

        target_match = re.search(
            r"telegram_target_ids\s*=\s*(.*)",
            raw,
            re.IGNORECASE,
        )

        if target_match:
            target_ids = set()

            for item in (
                target_match.group(1)
                .split(",")
            ):
                normalized = (
                    normalize_command_device_id(
                        item
                    )
                )

                if normalized:
                    target_ids.add(
                        normalized
                    )

            metadata["target_ids"] = (
                target_ids
            )

        expiry_match = re.search(
            r"telegram_expires_at\s*=\s*(\d+)",
            raw,
            re.IGNORECASE,
        )

        if expiry_match:
            try:
                metadata["expires_at"] = int(
                    expiry_match.group(1)
                )
            except (
                TypeError,
                ValueError,
            ):
                metadata["expires_at"] = 0

        cursor -= 1

    return metadata


def command_id_timestamp_ms(command_id):
    match = re.match(
        r"^(\d{10,})",
        str(command_id or "").strip(),
    )

    if not match:
        return 0

    try:
        return int(match.group(1))
    except (TypeError, ValueError):
        return 0


def normalize_processed_command_ids(value):
    if not isinstance(value, list):
        return []

    result = []
    seen = set()

    for item in value:
        command_id = str(item or "").strip()

        if (
            not command_id
            or not re.fullmatch(
                r"[\w-]+",
                command_id,
            )
            or command_id in seen
        ):
            continue

        seen.add(command_id)
        result.append(command_id)

    return result[-PROCESSED_COMMAND_IDS_MAX:]


def prune_processed_command_ids(
    state,
    now_ms=None,
):
    if now_ms is None:
        now_ms = int(time.time() * 1000)

    kept = []

    for command_id in normalize_processed_command_ids(
        state.get("processed_command_ids")
    ):
        created_ms = command_id_timestamp_ms(
            command_id
        )

        if (
            created_ms > 0
            and now_ms - created_ms
            > PROCESSED_COMMAND_RETENTION_MS
        ):
            continue

        kept.append(command_id)

    state["processed_command_ids"] = (
        kept[-PROCESSED_COMMAND_IDS_MAX:]
    )

    return state["processed_command_ids"]


def command_id_already_processed(
    state,
    command_id,
):
    command_id = str(command_id or "").strip()

    if not command_id:
        return False

    return command_id in set(
        prune_processed_command_ids(state)
    )


def mark_command_id_processed(
    state,
    command_id,
    now_ms=None,
):
    command_id = str(command_id or "").strip()

    if not command_id:
        return

    current = prune_processed_command_ids(
        state,
        now_ms=now_ms,
    )

    current = [
        item
        for item in current
        if item != command_id
    ]

    current.append(command_id)

    state["processed_command_ids"] = (
        current[-PROCESSED_COMMAND_IDS_MAX:]
    )
    state["last_command_id"] = command_id


def command_blocks_from_source(
    source_name,
    source_text,
):
    lines = (source_text or "").splitlines()
    items = []
    legacy_lines = []
    index = 0
    sequence = 0

    while index < len(lines):
        raw = lines[index].strip()

        if not raw:
            index += 1
            continue

        if raw.startswith("#"):
            metadata_lines = []
            command_id = ""

            while index < len(lines):
                current = lines[index].strip()

                if not current:
                    index += 1
                    continue

                if not current.startswith("#"):
                    break

                metadata_lines.append(lines[index])

                match = re.search(
                    r"telegram_command_id\s*=\s*([\w-]+)",
                    current,
                )

                if match:
                    command_id = (
                        match.group(1).strip()
                    )

                index += 1

            if command_id:
                command_lines = []

                while index < len(lines):
                    current = lines[index].strip()

                    if current.startswith("#"):
                        break

                    if current:
                        command_lines.append(
                            lines[index]
                        )

                    index += 1

                if command_lines:
                    items.append({
                        "timestamp":
                            command_id_timestamp_ms(
                                command_id
                            ),
                        "source_name": source_name,
                        "sequence": sequence,
                        "command_id": command_id,
                        "lines":
                            metadata_lines
                            + command_lines,
                    })
                    sequence += 1

                continue

            continue

        legacy_lines.append(lines[index])
        index += 1

    if legacy_lines:
        items.append({
            "timestamp": 0,
            "source_name": source_name,
            "sequence": -1,
            "command_id": "",
            "lines": legacy_lines,
        })

    return items


def ordered_command_lines_from_sources(
    changed_sources,
):
    items = []

    for source_index, (
        source_name,
        source_text,
    ) in enumerate(changed_sources):
        for item in command_blocks_from_source(
            source_name,
            source_text,
        ):
            item["source_index"] = source_index
            items.append(item)

    items.sort(
        key=lambda item: (
            item["timestamp"],
            item["source_index"],
            item["sequence"],
        )
    )

    result = []

    for item in items:
        print(
            "[+] Khối lệnh: "
            f"{item['source_name']} "
            f"COMMAND_ID={item['command_id'] or '-'} "
            f"timestamp={item['timestamp']}"
        )
        result.extend(item["lines"])
        result.append("")

    return result


def load_agent_config():
    if not os.path.exists(AGENT_CONFIG_PATH):
        return {}

    try:
        with open(AGENT_CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)

        if not isinstance(data, dict):
            return {}

        report_url = data.get("worker_report_url")
        secret = data.get("agent_report_secret")

        if not isinstance(report_url, str) or not report_url.strip():
            return {}

        parsed = urllib.parse.urlparse(report_url.strip())
        if parsed.scheme not in ("http", "https") or not parsed.netloc:
            return {}

        if not isinstance(secret, str) or not secret.strip():
            return {}

        return {
            "worker_report_url": report_url.strip(),
            "agent_report_secret": secret.strip(),
        }
    except Exception:
        # Không ghi nội dung cấu hình hoặc secret vào log.
        return {}


def load_device_id():
    path = "/storage/emulated/0/Download/Shouko/device_id.txt"

    try:
        if not os.path.exists(path):
            log_error(
                "load_device_id",
                FileNotFoundError(path),
            )
            return None

        with open(path, "r", encoding="utf-8") as f:
            raw_device_id = f.read().strip()

        # Tên động: m1 ... m999999.
        dynamic_match = re.fullmatch(
            r"m([1-9]\d{0,5})",
            raw_device_id,
            re.IGNORECASE,
        )

        if dynamic_match:
            return f"m{dynamic_match.group(1)}"

        # Giữ tương thích với 20 ID cũ.
        legacy_device_id = raw_device_id.upper()

        legacy_match = re.fullmatch(
            r"(MARMOT|NOVA)-(\d{2})",
            legacy_device_id,
        )

        if not legacy_match:
            raise ValueError(
                "Invalid device_id format: "
                f"{raw_device_id}. "
                "Expected m<number>, "
                "MARMOT-01..10 or NOVA-01..10"
            )

        number = int(legacy_match.group(2))

        if number < 1 or number > 10:
            raise ValueError(
                f"Device index out of range: "
                f"{legacy_device_id}"
            )

        return legacy_device_id

    except Exception as e:
        log_error("load_device_id", e)
        return None

def read_first_text(path):
    try:
        with open(
            path,
            "r",
            encoding="utf-8",
        ) as file:
            return file.read().strip()
    except Exception:
        return ""


def run_short_command(command):
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=3,
        )

        if result.returncode == 0:
            return result.stdout.strip()
    except Exception:
        pass

    return ""


def collect_device_metrics():
    metrics = {
        "agent_version":
            AGENT_VERSION,
        "reload_novagag2_capable":
            RELOAD_NOVAGAG2_CAPABLE,
        "secure_solver_capable":
            SECURE_SOLVER_CAPABLE,
        "self_heal_capable":
            SELF_HEAL_CAPABLE,
        "deferred_command_queue_capable":
            DEFERRED_COMMAND_QUEUE_CAPABLE,
    }

    capacity = read_first_text(
        "/sys/class/power_supply/"
        "battery/capacity"
    )

    if capacity.isdigit():
        value = int(capacity)

        if 0 <= value <= 100:
            metrics["battery_level"] = value

    battery_status = read_first_text(
        "/sys/class/power_supply/"
        "battery/status"
    ).lower()

    if battery_status:
        metrics["charging"] = (
            battery_status in {
                "charging",
                "full",
            }
        )

    getprop = (
        "/system/bin/getprop"
        if os.path.exists(
            "/system/bin/getprop"
        )
        else "getprop"
    )

    android_version = run_short_command(
        [
            getprop,
            "ro.build.version.release",
        ]
    )

    if android_version:
        metrics["android_version"] = (
            android_version[:32]
        )

    uptime_text = read_first_text(
        "/proc/uptime"
    )

    if uptime_text:
        try:
            metrics["uptime_seconds"] = int(
                float(
                    uptime_text.split()[0]
                )
            )
        except Exception:
            pass

    try:
        storage = shutil.disk_usage(
            "/storage/emulated/0"
        )

        metrics["storage_free_bytes"] = int(
            storage.free
        )
    except Exception:
        pass

    return metrics


def send_report_to_worker(report_url, secret, payload):
    try:
        if not report_url or not secret:
            return False
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(report_url, data=data, method="POST")
        req.add_header("Content-Type", "application/json")
        req.add_header(
            "User-Agent",
            "Mozilla/5.0 (Linux; Android 14) "
            "AppleWebKit/537.36 (KHTML, like Gecko) "
            "Chrome/124.0 Mobile Safari/537.36"
        )
        req.add_header("Accept", "application/json")
        req.add_header("X-Agent-Secret", secret)
        # Do not log secret
        with urllib.request.urlopen(req, timeout=10) as resp:
            resp.read()
        return True
    except urllib.error.HTTPError as e:
        log_error("send_report_to_worker_http", e)
        return False
    except Exception as e:
        log_error("send_report_to_worker", e)
        return False



def heartbeat_loop(
    stop_event,
    device_id,
    state,
):
    while not stop_event.is_set():
        current_group = get_device_group()

        if (
            current_group
            not in GROUP_COMMAND_URLS
        ):
            stop_event.wait(30)
            continue

        current_cfg = load_agent_config()

        report_url = current_cfg.get(
            "worker_report_url"
        )

        secret = current_cfg.get(
            "agent_report_secret"
        )

        timestamp = (
            datetime.datetime.utcnow()
            .strftime(
                "%Y-%m-%dT%H:%M:%SZ"
            )
        )

        payload = {
            "device_id": device_id,
            "device_group": current_group,
            "timestamp": timestamp,
            "status": "heartbeat",
            "command_id":
                state.get(
                    "last_command_id",
                    "",
                ),
            "last_result":
                state.get(
                    "last_result",
                    "",
                ),
        }

        payload.update({
            "setup_health":
                state.get(
                    "setup_health",
                    "unknown",
                ),
            "last_reconcile_at":
                state.get(
                    "last_reconcile_at",
                    "",
                ),
            "last_repair_result":
                state.get(
                    "last_repair_result",
                    "",
                ),
            "needs_manual_action":
                bool(
                    state.get(
                        "needs_manual_action",
                        False,
                    )
                ),
        })

        payload.update(
            collect_device_metrics()
        )

        try:
            send_report_to_worker(
                report_url,
                secret,
                payload,
            )
        except Exception:
            pass

        stop_event.wait(30)

def load_state():
    ensure_parent_dir(STATE_PATH)
    default_state = {
        "device_group": "",
        "common_command_hash": "",
        "group_command_hash": "",
        "last_processed_at": "",
        "last_command_id": "",
        "processed_command_ids": [],
        "last_result": "",
        "setup_health": "unknown",
        "last_reconcile_at": "",
        "last_repair_result": "",
        "needs_manual_action": False,
    }

    if not os.path.exists(STATE_PATH):
        return default_state.copy()

    try:
        with open(STATE_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)

        state = default_state.copy()
        for key in state:
            state[key] = data.get(key, state[key])

        journal = normalize_processed_command_ids(
            state.get("processed_command_ids")
        )

        legacy_last = str(
            state.get("last_command_id") or ""
        ).strip()

        if (
            legacy_last
            and legacy_last not in journal
        ):
            journal.append(legacy_last)

        state["processed_command_ids"] = journal
        prune_processed_command_ids(state)
        return state
    except Exception as e:
        log_error("load_state", e)
        return default_state.copy()

def save_state(state):
    ensure_parent_dir(STATE_PATH)
    tmp_path = STATE_PATH + ".tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
        os.replace(tmp_path, STATE_PATH)
    except Exception as e:
        log_error("save_state", e)
        if os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except Exception:
                pass


