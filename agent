def log_error(action_name, exception_obj, group=None):
    try:
        err_time = datetime.datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC")
        tb = traceback.format_exc()
        group_part = f" [group={group}]" if group else ""
        msg = f"[{err_time}]{group_part} Error in {action_name}: {exception_obj}\n{tb}\n"
        with open("/sdcard/Download/Agent_Error.txt", "a", encoding='utf-8') as f:
            f.write(msg)
        print(msg)
    except Exception as log_e:
        print("[!] Failed to write error log:", log_e)


def ensure_parent_dir(path):
    parent = os.path.dirname(path)
    if parent:
        os.makedirs(parent, exist_ok=True)


def calculate_sha256(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def load_state():
    ensure_parent_dir(STATE_PATH)
    if not os.path.exists(STATE_PATH):
        return {
            "device_group": "",
            "common_command_hash": "",
            "group_command_hash": "",
            "last_processed_at": "",
        }
    try:
        with open(STATE_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        return {
            "device_group": data.get("device_group", ""),
            "common_command_hash": data.get("common_command_hash", ""),
            "group_command_hash": data.get("group_command_hash", ""),
            "last_processed_at": data.get("last_processed_at", ""),
        }
    except Exception as e:
        log_error("load_state", e)
        return {
            "device_group": "",
            "common_command_hash": "",
            "group_command_hash": "",
            "last_processed_at": "",
        }


def save_state(state):
    ensure_parent_dir(STATE_PATH)
    tmp_path = STATE_PATH + ".tmp"
    try:
        with open(tmp_path, "w", encoding="utf-8") as f:
            json.dump(state, f, ensure_ascii=False, indent=2)
        os.replace(tmp_path, STATE_PATH)
    except Exception as e:
        log_error("save_state", e)
        if os.path.exists(tmp_path):
            try:
                os.remove(tmp_path)
            except Exception:
                pass


def get_device_group():
    ensure_parent_dir(GROUP_PATH)
    if not os.path.exists(GROUP_PATH):
        log_error("get_device_group", FileNotFoundError(GROUP_PATH))
        return None
    try:
        with open(GROUP_PATH, "r", encoding="utf-8") as f:
            group = f.read().strip().upper()
        if group not in GROUP_COMMAND_URLS:
            raise ValueError(f"Invalid device group: {group}")
        return group
    except Exception as e:
        log_error("get_device_group", e)
        return None


def fetch_text(url, source_name):
    try:
        parsed = urllib.parse.urlparse(url)
        if parsed.scheme not in ("http", "https") or not parsed.netloc:
            raise ValueError(f"Invalid URL: {url}")
        sep = "&" if parsed.query else "?"
        fetch_url = f"{url}{sep}t={int(time.time())}"
        headers = {
            "User-Agent": "Mozilla/5.0",
            "Cache-Control": "no-cache, no-store, must-revalidate",
            "Pragma": "no-cache",
            "Expires": "0",
        }
        req = urllib.request.Request(fetch_url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as response:
            return response.read().decode("utf-8")
    except Exception as e:
        log_error(f"fetch_text_{source_name}", e)
        return None


def get_command_sources(group):
    sources = [("COMMON", COMMON_COMMAND_URL)]
    if group in GROUP_COMMAND_URLS:
        sources.append((group, GROUP_COMMAND_URLS[group]))
    return sources


def fetch_commands_for_group(group):
    if not group:
        return None, None
    common_text = fetch_text(COMMON_COMMAND_URL, "COMMON")
    group_text = fetch_text(GROUP_COMMAND_URLS.get(group, ""), group)
    return common_text, group_text


def is_valid_url(url):
    if "\n" in url or "\r" in url:
        return False
    try:
        parsed = urllib.parse.urlparse(url)
        return parsed.scheme in ("http", "https") and bool(parsed.netloc)
    except Exception:
        return False


def install_group_script(group):
    if group not in GROUP_SCRIPT_URLS:
        log_error("install_group_script", ValueError(f"Unsupported group: {group}"), group)
        return
    script_url = GROUP_SCRIPT_URLS[group]
    if not is_valid_url(script_url):
        log_error("install_group_script", ValueError(f"Invalid group script URL: {script_url}"), group)
        return
    try:
        os.makedirs(AUTOEXECUTE_DIR, exist_ok=True)
        if os.path.exists(GROUP_SCRIPT_FILE):
            os.remove(GROUP_SCRIPT_FILE)
        if "?" in script_url:
            lua_body = f'loadstring(game:HttpGet("{script_url}&t=" .. tostring(os.time())))()'
        else:
            lua_body = f'loadstring(game:HttpGet("{script_url}?t=" .. tostring(os.time())))()'
        with open(GROUP_SCRIPT_FILE, "w", encoding="utf-8") as f:
            f.write(lua_body + "\n")
        with open(GROUP_SCRIPT_FILE, "r", encoding="utf-8") as f:
            actual = f.read().strip()
        if actual != lua_body:
            raise IOError("Group script verification failed")
        print(f"[+] INSTALL_GROUP_SCRIPT: group={group}, url={script_url}, file={GROUP_SCRIPT_FILE}")
    except Exception as e:
        log_error("install_group_script", e, group)


def install_custom_script(script_url):
    print(f"\n[*] PHÁT HIỆN LINK SCRIPT MỚI, ĐANG DÁN VÀO DELTA...")
    if not is_valid_url(script_url):
        log_error("install_custom_script", ValueError(f"Invalid URL: {script_url}"))
        return
    try:
        os.makedirs(AUTOEXECUTE_DIR, exist_ok=True)
        target_file = os.path.join(AUTOEXECUTE_DIR, "main_farm_script.lua")
        if os.path.exists(target_file):
            os.remove(target_file)
        lua_body = f'loadstring(game:HttpGet("{script_url}"))()'
        with open(target_file, "w", encoding="utf-8") as f:
            f.write(lua_body + "\n")
        with open(target_file, "r", encoding="utf-8") as f:
            if f.read().strip() != lua_body:
                raise IOError("Verification failed for custom script file")
        print(f"[+] Đã dán link mới vào tự động chạy thành công! file={target_file}")
    except Exception as e:
        log_error("install_custom_script", e)

# Hàm 1: Tự động quét Github, tải và cài đặt Delta
def auto_update_system():
    print("\n[*] BẮT ĐẦU QUY TRÌNH KÉO FILE VÀ CÀI ĐẶT...")
    if not os.path.exists(DOWNLOAD_DIR):
        os.makedirs(DOWNLOAD_DIR)

    api_url = f"https://api.github.com/repos/{OWNER}/{REPO}/releases/latest"
    try:
        req = urllib.request.Request(api_url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=10) as response:
            data = json.loads(response.read().decode())
            assets = data.get("assets", [])

        if not assets:
            return print("[!] Không tìm thấy file nào trên Release GitHub.")

        for idx, asset in enumerate(assets, 1):
            file_name = asset["name"]
            dl_url = asset["browser_download_url"]
            file_path = os.path.join(DOWNLOAD_DIR, file_name)

            print(f" -> Đang tải: {file_name}")
            urllib.request.urlretrieve(dl_url, file_path)

            if file_name.endswith(".zip"):
                extract_path = os.path.join(DOWNLOAD_DIR, f"extracted_{file_name}")
                os.makedirs(extract_path, exist_ok=True)
                try:
                    with zipfile.ZipFile(file_path, 'r') as zip_ref:
                        zip_ref.extractall(extract_path)
                except Exception as e:
                    log_error("auto_update_system_unzip", e)
                    continue
                    
                for root, dirs, files in os.walk(extract_path):
                    for f in files:
                        if f.endswith(".apk"):
                            apk_path = os.path.join(root, f)
                            print(f"   => Cài đặt đè: {f} ...")
                            subprocess.run(f"su -c 'pm install -r \"{apk_path}\"'", shell=True)

            elif file_name.endswith(".apk"):
                print(f"   => Cài đặt đè: {file_name} ...")
                subprocess.run(f"su -c 'pm install -r \"{file_path}\"'", shell=True)

        print("[+] CẬP NHẬT DELTA HOÀN TẤT CHO THIẾT BỊ NÀY!")
    except Exception as e:
        log_error("auto_update_system", e)

# Hàm 2: Tự động đổi link Solver API (Đã nâng cấp bóc link Github)
def update_solver_url(new_url):
    print(f"\n[*] ĐANG TIẾN HÀNH TRÁO LINK SOLVER...")
    
    if "raw.githubusercontent.com" in new_url:
        print("[*] Phát hiện link GitHub, đang bóc tách link gốc...")
        try:
            req = urllib.request.Request(new_url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=10) as response:
                new_url = response.read().decode('utf-8').strip()
                print(f"[+] Lấy link gốc thành công: {new_url[:30]}...")
        except Exception as e:
            log_error("update_solver_url_fetch", e)
            return

    if not os.path.exists(CONFIG_PATH):
        return print(f"[!] Lỗi: Không tìm thấy file {CONFIG_PATH} trong máy ảo.")
    
    try:
        with open(CONFIG_PATH, 'r', encoding='utf-8') as f:
            content = f.read()
        
        updated_content = re.sub(r'"solver_url":\s*"[^"]*"', f'"solver_url": "{new_url}"', content)
        
        with open(CONFIG_PATH, 'w', encoding='utf-8') as f:
            f.write(updated_content)
            
        print(f"[+] Thành công! Đã cấy link solver thật vào config.json")
    except Exception as e:
        log_error("update_solver_url_write", e)

