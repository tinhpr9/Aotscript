print("="*50)
print("  📡 HỆ THỐNG C&C ĐÃ SẴN SÀNG (BẢN CHUẨN)  ")
print("="*50)

while True:
    try:
        # Lách cache ngay trên link lấy lệnh điều khiển
        url_no_cache = f"{COMMAND_URL}?t={int(time.time())}"
        req = urllib.request.Request(url_no_cache, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req) as response:
            full_text = response.read().decode('utf-8').strip()
        
        if full_text and full_text != LAST_CMD_TEXT:
            LAST_CMD_TEXT = full_text
            
            # Tách riêng từng dòng lệnh ra để xử lý (chống lỗi enter)
            commands = full_text.splitlines()
            
            print(f"\n[!] PHÁT HIỆN {len(commands)} LỆNH MỚI TỪ GITHUB!")
            
            for cmd in commands:
                cmd = cmd.strip()
                if not cmd:
                    continue
                    
                if cmd == "UPDATE_DELTA":
                    auto_update_system()
                
                elif cmd.startswith("UPDATE_SOLVER"):
                    parts = cmd.split(" ", 1)
                    if len(parts) > 1:
                        update_solver_url(parts[1].strip())
                        
                elif cmd == "INSTALL_TRACK":
                    install_qhtrack()
                    
                elif cmd == "INSTALL_MARMOT":
                    install_marmotgag2()
                    
                elif cmd == "REBOOT":
                    print("[*] Đang ép khởi động lại thiết bị...")
                    time.sleep(2)
                    os.system("su -c 'reboot'")
                    
                elif cmd == "IDLE":
                    print("[💤] Đã nhận lệnh nghỉ ngơi.")
                    
            print("\n[*] ĐÃ THỰC THI XONG TOÀN BỘ LỆNH. CHỜ VIỆC TIẾP THEO...\n")
                
    except Exception as e:
        pass
        
    time.sleep(15)
