        common_hash = (
            calculate_sha256(common_text)
            if common_text is not None
            else None
        )
        group_hash = (
            calculate_sha256(group_text)
            if group_text is not None
            else None
        )

        common_changed = (
            common_hash is not None
            and common_hash != state.get("common_command_hash")
        )
        group_changed = (
            group_hash is not None
            and group_hash != state.get("group_command_hash")
        )

        if not common_changed and not group_changed:
            time.sleep(15)
            continue

        changed_sources = []

        if common_changed:
            changed_sources.append(("COMMON", common_text))

        if group_changed:
            changed_sources.append((group, group_text))

        # Nguồn có command timestamp nhỏ hơn chạy trước.
        # Nhờ vậy command mới nhất luôn chạy sau cùng và giữ last_command_id.
        changed_sources.sort(
            key=lambda source: command_timestamp_for_sort(source[1])
        )

        # Lưu hash trước khi thực thi để các lệnh gây reboot không bị lặp vô hạn.
        if common_changed:
            state["common_command_hash"] = common_hash

        if group_changed:
            state["group_command_hash"] = group_hash

        state["last_processed_at"] = (
            datetime.datetime.utcnow().strftime(
                "%Y-%m-%d %H:%M:%S UTC"
            )
        )
        save_state(state)

        # Chỉ ghép các nguồn vừa thay đổi, theo thứ tự cũ -> mới.
        command_lines = []

        for source_name, source_text in changed_sources:
            print(
                f"[+] Nguồn lệnh thay đổi: {source_name} "
                f"(timestamp={command_timestamp_for_sort(source_text)})"
            )
            command_lines.extend((source_text or "").splitlines())

        # scan lines and group by command_id if present
        i = 0
        total_detected = 0
        while i < len(command_lines):
            raw = command_lines[i].strip()
            if not raw:
                i += 1
                continue

            # comment handling
            if raw.startswith("#"):
                # look for telegram_command_id
                m = re.search(r"telegram_command_id\s*=\s*([\w\-]+)", raw)
                if m:
                    cmd_id = m.group(1).strip()
                    # skip empty or duplicate
                    if cmd_id and cmd_id != state.get("last_command_id"):
                        # collect following commands until next comment or EOF
                        j = i + 1
                        group_cmds = []
                        while j < len(command_lines):
                            line_j = command_lines[j].strip()
                            if not line_j:
                                j += 1
                                continue
                            if line_j.startswith("#"):
                                break
                            group_cmds.append(line_j)
                            j += 1

                        metadata = command_metadata_before(
                            command_lines,
                            i,
                        )

                        target_ids = metadata.get(
                            "target_ids"
                        )

                        if (
                            target_ids is not None
                            and device_id not in target_ids
                        ):
                            print(
                                f"[*] Bỏ qua COMMAND_ID={cmd_id}: "
                                f"không nhắm tới {device_id}"
                            )
                            i = j
                            continue

                        expires_at = int(
                            metadata.get(
                                "expires_at",
                                0,
                            )
                            or 0
                        )

                        if (
                            expires_at > 0
                            and int(time.time() * 1000)
                            > expires_at
                        ):
                            current_cfg = load_agent_config()

                            report_url = current_cfg.get(
                                "worker_report_url"
                            )

                            secret = current_cfg.get(
                                "agent_report_secret"
                            )

                            timestamp_expired = (
                                datetime.datetime.utcnow()
                                .strftime(
                                    "%Y-%m-%dT%H:%M:%SZ"
                                )
                            )

                            payload_expired = {
                                "device_id": device_id,
                                "device_group": group,
                                "timestamp":
                                    timestamp_expired,
                                "status": "expired",
                                "command_id": cmd_id,
                                "command": None,
                                "last_result": "expired",
                            }

                            try:
                                send_report_to_worker(
                                    report_url,
                                    secret,
                                    payload_expired,
                                )
                            except Exception:
                                pass

                            state["last_command_id"] = (
                                cmd_id
                            )

                            state["last_result"] = (
                                "expired"
                            )

                            save_state(state)

                            print(
                                f"[!] COMMAND_ID={cmd_id} "
                                "đã hết hạn; không thực thi."
                            )

                            i = j
                            continue
                        total_detected += len(group_cmds)
                        print(f"\n[!] PHÁT HIỆN COMMAND_ID={cmd_id} with {len(group_cmds)} lệnh (group={group})")
                        # report received for this command id
                        cfg = cfg if 'cfg' in globals() else load_agent_config()
                        report_url = cfg.get("worker_report_url")
                        secret = cfg.get("agent_report_secret")
                        ts = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
                        payload = {
                            "device_id": device_id,
                            "device_group": group,
                            "timestamp": ts,
                            "status": "received",
                            "command_id": cmd_id,
                            "command": None,
                        }
                        try:
                            send_report_to_worker(report_url, secret, payload)
                        except Exception:
                            pass
                        # persist last_command_id
                        state["last_command_id"] = cmd_id
                        save_state(state)

                        # execute grouped commands in order
                        for idx_c, single_cmd in enumerate(group_cmds, start=1):
                            # send running status with progress
                            ts_run = datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
                            payload_run = {
                                "device_id": device_id,
                                "device_group": group,
                                "timestamp": ts_run,
                                "status": "running",
                                "command_id": cmd_id,
                                "command": single_cmd,
                                "command_index": idx_c,
                                "command_total": len(group_cmds),
                            }
                            try:
                                send_report_to_worker(report_url, secret, payload_run)
                            except Exception:
                                pass

                            # execute the command (preserve original logic)
                            try:
                                if single_cmd.startswith("Updatescript "):
                                    link = single_cmd.split(" ", 1)[1].strip()
