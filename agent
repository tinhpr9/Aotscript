def fetch_secure_solver_url():
    config = load_agent_config()
    report_url = config.get("worker_report_url")
    secret = config.get("agent_report_secret")
    if not report_url or not secret:
        raise RuntimeError("Thiếu cấu hình báo cáo Agent")
    parsed = urllib.parse.urlparse(report_url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc:
        raise RuntimeError("worker_report_url không hợp lệ")
    endpoint = urllib.parse.urlunparse((
        parsed.scheme, parsed.netloc, "/agent/solver-url", "", "", "",
    ))
    request = urllib.request.Request(
        endpoint,
        method="GET",
        headers={
            "Accept": "application/json",
            "Cache-Control": "no-cache",
            "User-Agent": "Mozilla/5.0",
            "X-Agent-Secret": secret,
        },
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        raw = response.read(4097)
    if len(raw) > 4096:
        raise RuntimeError("Phản hồi Solver quá lớn")
    try:
        payload = json.loads(raw.decode("utf-8"))
    except Exception as error:
        raise RuntimeError("Phản hồi Solver không phải JSON") from error
    solver_url = payload.get("solver_url") if isinstance(payload, dict) else None
    if not isinstance(solver_url, str) or not is_valid_url(solver_url.strip()):
        raise RuntimeError("Worker chưa có Solver URL hợp lệ")
    return solver_url.strip()


