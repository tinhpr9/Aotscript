{
  "name": "billowing-haze-0cafaotscript-control",
  "main": "worker.js",
  "compatibility_date": "2026-08-03",
  "observability": {
    "logs": {
      "invocation_logs": false
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DEVICE_STATUS"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FLEET_STATE",
        "class_name": "FleetState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_fleet_state_20260805",
      "new_sqlite_classes": [
        "FleetState"
      ]
    }
  ]
}
